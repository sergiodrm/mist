#version 460

struct Particle
{
    vec3 position;
    float lifetime;
    vec4 velocity;
    vec4 color;
};

layout (std140, binding = 0) uniform ParameterUBO
{
    float deltaTime;
    float time;
    float freqX;
    float freqY;
} u_params;

layout(std140, binding = 1) buffer ParticleBuffer
{
    Particle data[];
} u_particlesRead;


layout(std140, binding = 2) buffer ParticleBuffer1
{
    Particle data[];
} u_particlesWrite;

layout (local_size_x= 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint index = gl_GlobalInvocationID.x;

    Particle pin = u_particlesRead.data[index];
    pin.position -= vec3(0.f, u_params.deltaTime*pin.velocity.y, 0.f);
    if (pin.position.y < -10.f)
        pin.position.y += 50.f;
    u_particlesWrite.data[index] = pin;
}
