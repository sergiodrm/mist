#version 450

layout (quads, fractional_odd_spacing, ccw) in;


#include <shaders/includes/model.glsl>
#include <shaders/includes/camera.glsl>


// Uniforms
layout (set = 0, binding = 0) uniform CameraBlock 
{
	Camera data;
} u_camera;

layout (set = 0, binding = 1) uniform PrevCameraBlock 
{
	Camera data;
} u_prevCamera;

layout (set = 2, binding = 0) uniform sampler2D u_HeightMap;
layout (set = 2, binding = 1) uniform UBO
{
    float heightScale;
    float heightShift;
    vec2 uvPadding;
} u_params;

layout (location = 0) in vec2 inTexCoords[];
layout (location = 1) in vec3 inWorldPos[];
layout (location = 2) in vec4 inCurrWSPos[];
layout (location = 3) in vec4 inPrevWSPos[];

layout (location = 0) out vec2 outTexCoords;
layout (location = 1) out vec3 outWorldPos;
layout (location = 2) out vec4 outCurrWSPos;
layout (location = 3) out vec4 outPrevWSPos;

void main()
{
    float u = gl_TessCoord.x;
    float v = gl_TessCoord.y;

    vec2 t00 = inTexCoords[0];
    vec2 t01 = inTexCoords[1];
    vec2 t10 = inTexCoords[2];
    vec2 t11 = inTexCoords[3];

    vec2 t0 = (t01-t00)*u + t00;
    vec2 t1 = (t11-t10)*u + t10;
    vec2 texCoord = ((t1-t0)*v + t0) + u_params.uvPadding;

    float height = texture(u_HeightMap, texCoord).y * u_params.heightScale - u_params.heightShift;

    vec4 p00 = gl_in[0].gl_Position;
    vec4 p01 = gl_in[1].gl_Position;
    vec4 p10 = gl_in[2].gl_Position;
    vec4 p11 = gl_in[3].gl_Position;

    vec4 uVec = p01-p00;
    vec4 vVec = p10-p00;
    vec4 normal = normalize(vec4(cross(vVec.xyz, uVec.xyz), 0));

    vec4 p0 = (p01-p00)*u + p00;
    vec4 p1 = (p11-p10)*u + p10;
    vec4 p = (p1-p0)*v + p0;

    //normal = vec4(0,1,0,0);
    p+=normal*height;

    gl_Position = u_camera.data.viewProjection * p;

    outTexCoords = texCoord;
    outWorldPos = p.xyz;
    outCurrWSPos = p;
    outPrevWSPos = p;
}